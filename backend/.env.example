TRANSLATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
# Optional GPU STT. Install the model and requirements-stt-gpu.txt first.
# YLD_STT_MODEL=large-v3-turbo
# YLD_STT_DEVICE=cuda
# YLD_STT_COMPUTE=int8_float16
# YLD_STT_PROMPT=Google. Gemini. Claude. Opus. Blender. Antigravity. CLI. API.
# YLD_AUDIT=1
# Local translation uses no external AI API. Z.ai/OpenAI remain opt-in providers.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini

TTS_PROVIDER=supertonic3
# Supertonic 3 runs locally; speech speed is fixed at 1.15.
# Optional custom Python path. Otherwise the project virtual environment is used.
# SUPERTONIC_PYTHON=
# The following settings apply only when selecting the Supertone HTTP API.
SUPERTONE_MODEL=sona_speech_2_flash
SUPERTONE_API_KEY=
SUPERTONE_DEFAULT_VOICE_ID=763d5f200a9f5808056733
SUPERTONE_PITCH_SHIFT=0
SUPERTONE_PITCH_VARIANCE=1.5
SUPERTONE_SPEED=1.29
SUPERTONE_STYLE=neutral
